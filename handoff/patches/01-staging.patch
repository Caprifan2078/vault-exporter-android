+    byte[] secret=new byte[32];Arrays.fill(secret,(byte)21);
+    File root=Files.createTempDirectory("vault-tvs2-regress-").toFile();
+    File staging=new File(root,"stage");
+    File plain=new File(root,"input.dat");
