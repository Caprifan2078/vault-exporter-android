diff -ruN a/.github/workflows/build-debug-apk.yml b/.github/workflows/build-debug-apk.yml
--- a/.github/workflows/build-debug-apk.yml	2026-10-24 07:49:09.173336832 +0000
+++ b/.github/workflows/build-debug-apk.yml	2026-10-24 07:42:44.487934970 +0000
@@ -69,8 +69,17 @@
             echo 'Official Android TDLib build did not produce an arm64-v8a libtdjson.so' >&2
             exit 1
           fi
+          # A library can have the correct ELF architecture but lack TDLib's
+          # required JSON symbols. Check the actual ABI before Gradle builds.
+          for symbol in td_create_client_id td_send td_receive; do
+            if ! readelf -W --dyn-syms "$so" | awk -v required="$symbol" '$8 == required { found = 1 } END { exit !found }' ; then
+              echo "Pinned TDLib binary lacks required JSON symbol: $symbol" >&2
+              exit 1
+            fi
+          done
           install -m 0644 "$so" app/src/main/jniLibs/arm64-v8a/libtdjson.so
           python3 scripts/preflight.py
+          sha256sum app/src/main/jniLibs/arm64-v8a/libtdjson.so | tee tdlib-sha256.txt
       - name: Run the COMPLETE reproducible offline suite before building APK
         run: bash RUN_ALL_OFFLINE.sh
       - name: Confirm test data center build only
@@ -86,13 +95,18 @@
           set -euo pipefail
           APK=app/build/outputs/apk/debug/app-debug.apk
           test -s "$APK"
-          unzip -l "$APK" | grep -q 'lib/arm64-v8a/libtdjson.so'
-          unzip -l "$APK" | grep -q 'lib/arm64-v8a/libvaultbridge.so'
+          unzip -Z1 "$APK" | grep -Fxq 'lib/arm64-v8a/libtdjson.so'
+          unzip -Z1 "$APK" | grep -Fxq 'lib/arm64-v8a/libvaultbridge.so'
+          # Confirm this artifact is a test-DC build, never a production build.
           sha256sum "$APK" | tee apk-sha256.txt
+          printf 'Source TDLib commit: %s\n' 'ea3f69ce11aef458bfbb09869b809ede4447486f' > build-provenance.txt
+          cat tdlib-sha256.txt apk-sha256.txt >> build-provenance.txt
       - uses: actions/upload-artifact@v4
         with:
           name: vault-exporter-test-dc-alpha-apk
           path: |
             app/build/outputs/apk/debug/app-debug.apk
             apk-sha256.txt
+            tdlib-sha256.txt
+            build-provenance.txt
           retention-days: 7
